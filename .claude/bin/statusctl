#!/usr/bin/env python3

import argparse
import fcntl
import hashlib
import json
import re
import subprocess
import tempfile
import time
from contextlib import contextmanager
from datetime import datetime, timezone
from pathlib import Path


ROOT = Path(__file__).resolve().parents[2]

STATUS = ROOT / ".claude/runtime/status.json"
AUDIT = ROOT / ".claude/runtime/audit.jsonl"
REPORT_PATH = ROOT / ".claude/runtime/latest_report.md"
REPORT = ".claude/runtime/latest_report.md"

LOCK_TIMEOUT_SECONDS = 10.0
LOCK_RETRY_SECONDS = 0.05

LOCK_KEY = hashlib.sha256(
    str(ROOT).encode("utf-8")
).hexdigest()[:16]

LOCK_PATH = (
    Path(tempfile.gettempdir())
    / f"cryptolab-statusctl-{LOCK_KEY}.lock"
)

SCHEMA_VERSION = "3.0"

LEGACY_SCHEMA_VERSION = "2.0"

TASK_KIND_WORK = "WORK"

TASK_KIND_INTEGRATION = "INTEGRATION"

VALID_TASK_KINDS = {
    TASK_KIND_WORK,
    TASK_KIND_INTEGRATION,
}

# Full Work Task lifecycle.
WORK_PHASES = {
    "ANALYZE",
    "IMPLEMENT",
    "TARGETED_TEST",
    "FULL_TEST",
    "ADVERSARIAL_REVIEW",
    "CORRECT_FINDINGS",
    "RETEST",
    "EXTERNAL_REVIEW",
    "CORRECT_EXTERNAL_FINDINGS",
    "FINAL_VERIFY",
}

# An Integration Task integrates an already reviewed Work Task. It
# never implements and never re-tests product code, so its lifecycle
# is deliberately narrow.
INTEGRATION_PHASES = {
    "ANALYZE",
    "FINAL_VERIFY",
}

PHASES_BY_TASK_KIND = {
    TASK_KIND_WORK: WORK_PHASES,
    TASK_KIND_INTEGRATION: INTEGRATION_PHASES,
}

VALID_PHASES = WORK_PHASES | INTEGRATION_PHASES

# Schema 2.0 predates the external-review phases.
LEGACY_PHASES = WORK_PHASES - {
    "EXTERNAL_REVIEW",
    "CORRECT_EXTERNAL_FINDINGS",
}

# An integration boundary belongs to an Integration Task, so these
# gate types are refused for a Work Task.
INTEGRATION_ONLY_GATE_TYPES = {
    "GIT_INTEGRATION",
}

VALID_GATE_TYPES = {
    "GIT_INTEGRATION",
    "DEPENDENCY_CHANGE",
    "DATA_MUTATION",
    "SECURITY_AUTH",
    "OS_CHANGE",
    "SEMANTIC_DECISION",
    "ARCHITECTURE_DECISION",
    "SCOPE_EXPANSION",
    "UNRESOLVED_DISCUSS",
    "OTHER",
}

READY_TEST_RESULTS = {
    "PASS",
    "NOT_REQUIRED",
}

VALID_STATES = {
    "IDLE",
    "RUNNING",
    "BLOCKED_HUMAN_DECISION",
    "READY_FOR_HUMAN_REVIEW",
    "FAILED",
}

VALID_GATE_DECISIONS = {
    "APPROVED",
    "ALTERNATIVE",
    "REJECTED",
}

TOP_LEVEL_KEYS = {
    "schema_version", "project", "state", "task_id", "task_title",
    "task_kind", "parent_task_id",
    "phase", "branch", "started_at", "updated_at", "completed_at",
    "tests", "human_gate", "last_gate_decision", "report",
}

# Schema 2.0 carried no task model.
LEGACY_TOP_LEVEL_KEYS = TOP_LEVEL_KEYS - {
    "task_kind",
    "parent_task_id",
}

MIGRATION_HINT = (
    "Runtime status uses schema "
    f"{LEGACY_SCHEMA_VERSION}, but this controller requires "
    f"schema {SCHEMA_VERSION}. Run an explicit migration first:\n"
    "    ./.claude/bin/statusctl migrate-v3 WORK\n"
    "    ./.claude/bin/statusctl migrate-v3 INTEGRATION "
    "PARENT_TASK_ID\n"
    "Normal commands never upgrade runtime state implicitly."
)

GATE_ID_RE = re.compile(r"^HG-[0-9]{8}-[0-9]{3,}$")


def now():
    return datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")


@contextmanager
def control_lock():
    """
    Serialize all statusctl commands for this worktree.

    The lock lives in the operating-system temporary directory rather than
    inside the repository so that read-only commands such as `show` remain
    repository-read-only on a fresh clone.

    The lock is process-scoped and automatically released by the OS when the
    process exits, including abnormal termination.
    """
    LOCK_PATH.parent.mkdir(
        parents=True,
        exist_ok=True,
    )

    with LOCK_PATH.open("a+") as handle:
        deadline = time.monotonic() + LOCK_TIMEOUT_SECONDS

        while True:
            try:
                fcntl.flock(
                    handle.fileno(),
                    fcntl.LOCK_EX | fcntl.LOCK_NB,
                )
                break

            except BlockingIOError:
                if time.monotonic() >= deadline:
                    raise SystemExit(
                        "Timed out waiting for statusctl lock "
                        f"after {LOCK_TIMEOUT_SECONDS:.1f}s: "
                        f"{LOCK_PATH}"
                    )

                time.sleep(LOCK_RETRY_SECONDS)

        try:
            yield

        finally:
            fcntl.flock(
                handle.fileno(),
                fcntl.LOCK_UN,
            )


def validation_error(message):
    raise SystemExit(f"Runtime state validation failed: {message}")


def require_exact_keys(value, expected, label):
    if not isinstance(value, dict):
        validation_error(f"{label} must be an object.")
    actual = set(value)
    missing = sorted(expected - actual)
    extra = sorted(actual - expected)
    if missing:
        validation_error(
            f"{label} is missing required keys: {', '.join(missing)}"
        )
    if extra:
        validation_error(
            f"{label} contains unsupported keys: {', '.join(extra)}"
        )


def require_non_empty_string(value, label):
    if not isinstance(value, str) or not value.strip():
        validation_error(f"{label} must be a non-empty string.")


def require_nullable_string(value, label):
    if value is not None and not isinstance(value, str):
        validation_error(f"{label} must be a string or null.")


def require_timestamp(value, label, nullable=False):
    if value is None:
        if nullable:
            return
        validation_error(
            f"{label} must be a valid timezone-aware date-time."
        )
    if not isinstance(value, str):
        validation_error(f"{label} must be a date-time string.")
    candidate = value[:-1] + "+00:00" if value.endswith("Z") else value
    try:
        parsed = datetime.fromisoformat(candidate)
    except ValueError:
        validation_error(
            f"{label} is not a valid ISO-8601 date-time: {value}"
        )
    if parsed.tzinfo is None or parsed.utcoffset() is None:
        validation_error(f"{label} must include timezone information.")


def require_gate_id(value, label):
    if not isinstance(value, str) or not GATE_ID_RE.fullmatch(value):
        validation_error(f"{label} must match HG-YYYYMMDD-NNN.")


def validate_string_list(value, label):
    if not isinstance(value, list):
        validation_error(f"{label} must be an array.")
    for index, item in enumerate(value):
        if not isinstance(item, str):
            validation_error(f"{label}[{index}] must be a string.")


def validate_test_result(result, label):
    if result is None:
        return
    require_exact_keys(result, {"command", "result", "summary"}, label)
    require_non_empty_string(result["summary"], f"{label}.summary")
    outcome = result["result"]
    if outcome in {"PASS", "FAIL"}:
        require_non_empty_string(result["command"], f"{label}.command")
    elif outcome == "NOT_REQUIRED":
        if result["command"] is not None:
            validation_error(
                f"{label}.command must be null when result is NOT_REQUIRED."
            )
    else:
        validation_error(
            f"{label}.result must be PASS, FAIL, or NOT_REQUIRED."
        )


def validate_human_gate(gate):
    if gate is None:
        return
    require_exact_keys(
        gate,
        {
            "gate_id", "type", "question", "recommendation",
            "alternatives", "risks", "opened_at",
        },
        "human_gate",
    )
    require_gate_id(gate["gate_id"], "human_gate.gate_id")
    if gate["type"] not in VALID_GATE_TYPES:
        validation_error(f"human_gate.type is invalid: {gate['type']}")
    require_non_empty_string(gate["question"], "human_gate.question")
    require_non_empty_string(
        gate["recommendation"], "human_gate.recommendation"
    )
    validate_string_list(gate["alternatives"], "human_gate.alternatives")
    validate_string_list(gate["risks"], "human_gate.risks")
    require_timestamp(gate["opened_at"], "human_gate.opened_at")


def validate_gate_decision(decision):
    if decision is None:
        return
    require_exact_keys(
        decision,
        {"gate_id", "decision", "resolved_at", "record"},
        "last_gate_decision",
    )
    require_gate_id(decision["gate_id"], "last_gate_decision.gate_id")
    if decision["decision"] not in VALID_GATE_DECISIONS:
        validation_error(
            "last_gate_decision.decision is invalid: "
            f"{decision['decision']}"
        )
    require_timestamp(
        decision["resolved_at"], "last_gate_decision.resolved_at"
    )
    require_non_empty_string(decision["record"], "last_gate_decision.record")


def same_task_identity(left, right):
    """
    Return True when two task IDs denote the same task.

    Comparison ignores surrounding whitespace, so a padded copy of an
    ID cannot present itself as a different task.
    """

    if not isinstance(left, str) or not isinstance(right, str):
        return False

    return left.strip() == right.strip()


def validate_task_model(data):
    """
    Enforce the schema-3.0 task model.

    IDLE
        task_kind=null, parent_task_id=null

    WORK
        task_kind="WORK", parent_task_id=null

    INTEGRATION
        task_kind="INTEGRATION", parent_task_id=<Work Task ID>

    The phase model is a function of task_kind: an Integration Task
    integrates work that is already reviewed, so Work-only phases such
    as IMPLEMENT are not legal for it.
    """

    task_kind = data["task_kind"]

    if task_kind is not None and task_kind not in VALID_TASK_KINDS:
        validation_error(f"task_kind is invalid: {task_kind}")

    require_nullable_string(data["parent_task_id"], "parent_task_id")

    if data["state"] == "IDLE":
        if task_kind is not None:
            validation_error("IDLE requires task_kind=null.")
        if data["parent_task_id"] is not None:
            validation_error("IDLE requires parent_task_id=null.")
        return

    if task_kind is None:
        validation_error(
            f"{data['state']} requires a non-null task_kind."
        )

    if task_kind == TASK_KIND_WORK:
        if data["parent_task_id"] is not None:
            validation_error(
                "WORK requires parent_task_id=null."
            )
    else:
        require_non_empty_string(
            data["parent_task_id"], "parent_task_id"
        )

        if same_task_identity(
            data["task_id"],
            data["parent_task_id"],
        ):
            validation_error(
                "INTEGRATION requires parent_task_id to differ "
                "from task_id: a task cannot be its own parent."
            )

    phase = data["phase"]
    allowed = PHASES_BY_TASK_KIND[task_kind]

    if phase is not None and phase not in allowed:
        validation_error(
            f"phase {phase} is not legal for a "
            f"{task_kind} task."
        )


def validate_state_shape(
    data,
    *,
    schema_version,
    top_level_keys,
    phases,
    task_model,
):
    """
    Shared structural and cross-field validation.

    The schema-3.0 contract and the legacy schema-2.0 contract share
    every field except the task model, so they share one
    implementation rather than drifting apart.
    """

    require_exact_keys(data, top_level_keys, "runtime status")

    if data["schema_version"] != schema_version:
        validation_error(
            f'schema_version must be "{schema_version}".'
        )
    if data["project"] != "CryptoLab-DataHub":
        validation_error('project must be "CryptoLab-DataHub".')
    if data["report"] != REPORT:
        validation_error(f"report must be {REPORT!r}.")
    if data["state"] not in VALID_STATES:
        validation_error(f"state is invalid: {data['state']}")
    if data["phase"] is not None and data["phase"] not in phases:
        validation_error(f"phase is invalid: {data['phase']}")

    require_nullable_string(data["task_id"], "task_id")
    require_nullable_string(data["task_title"], "task_title")
    require_nullable_string(data["branch"], "branch")
    require_timestamp(data["started_at"], "started_at", nullable=True)
    require_timestamp(data["updated_at"], "updated_at", nullable=True)
    require_timestamp(data["completed_at"], "completed_at", nullable=True)

    require_exact_keys(data["tests"], {"targeted", "full"}, "tests")
    validate_test_result(data["tests"]["targeted"], "tests.targeted")
    validate_test_result(data["tests"]["full"], "tests.full")
    validate_human_gate(data["human_gate"])
    validate_gate_decision(data["last_gate_decision"])

    if task_model:
        validate_task_model(data)

    state = data["state"]
    if state == "IDLE":
        nullable_fields = (
            "task_id", "task_title", "phase", "branch", "started_at",
            "updated_at", "completed_at", "human_gate", "last_gate_decision",
        )
        for field in nullable_fields:
            if data[field] is not None:
                validation_error(f"IDLE requires {field}=null.")
        if data["tests"]["targeted"] is not None or data["tests"]["full"] is not None:
            validation_error("IDLE requires all test results to be null.")
        return

    require_non_empty_string(data["task_id"], "task_id")
    require_non_empty_string(data["task_title"], "task_title")
    if data["phase"] is None:
        validation_error(f"{state} requires a non-null phase.")
    require_timestamp(data["started_at"], "started_at")
    require_timestamp(data["updated_at"], "updated_at")

    if state == "BLOCKED_HUMAN_DECISION":
        if data["human_gate"] is None:
            validation_error(
                "BLOCKED_HUMAN_DECISION requires an active human_gate."
            )
        if data["completed_at"] is not None:
            validation_error(
                "BLOCKED_HUMAN_DECISION requires completed_at=null."
            )
    elif data["human_gate"] is not None:
        validation_error(f"{state} requires human_gate=null.")

    if state == "RUNNING":
        if data["completed_at"] is not None:
            validation_error("RUNNING requires completed_at=null.")
    elif state == "READY_FOR_HUMAN_REVIEW":
        require_timestamp(data["completed_at"], "completed_at")
        if data["phase"] != "FINAL_VERIFY":
            validation_error(
                "READY_FOR_HUMAN_REVIEW requires phase=FINAL_VERIFY."
            )
        if not test_is_ready(data["tests"]["targeted"]):
            validation_error(
                "READY_FOR_HUMAN_REVIEW requires targeted test PASS "
                "or justified NOT_REQUIRED."
            )
        if not test_is_ready(data["tests"]["full"]):
            validation_error(
                "READY_FOR_HUMAN_REVIEW requires full test PASS "
                "or justified NOT_REQUIRED."
            )
    elif state == "FAILED":
        require_timestamp(data["completed_at"], "completed_at")


def validate_runtime_state(data):
    """
    Canonical schema-3.0 validator.

    This validator accepts schema 3.0 only. Legacy schema-2.0 state is
    not silently normalized here: it must pass through the explicit
    migrate-v3 path.
    """

    validate_state_shape(
        data,
        schema_version=SCHEMA_VERSION,
        top_level_keys=TOP_LEVEL_KEYS,
        phases=VALID_PHASES,
        task_model=True,
    )


def validate_legacy_runtime_state(data):
    """
    Validate a schema-2.0 state before it may be migrated.

    Migration transforms runtime state, so the input must be a valid
    v2 state rather than merely a JSON object that happens to carry a
    schema_version field.
    """

    validate_state_shape(
        data,
        schema_version=LEGACY_SCHEMA_VERSION,
        top_level_keys=LEGACY_TOP_LEVEL_KEYS,
        phases=LEGACY_PHASES,
        task_model=False,
    )


def git_output(args):
    try:
        return subprocess.check_output(
            ["git", *args],
            cwd=ROOT,
            text=True,
            stderr=subprocess.DEVNULL,
        ).strip()
    except Exception:
        return ""


def branch():
    value = git_output(["branch", "--show-current"])
    return value or None


def head():
    value = git_output(["log", "-1", "--oneline"])
    return value or "UNKNOWN"


def working_tree():
    value = git_output(["status", "--short"])
    return value or "clean"


def idle_state():
    data = {
        "schema_version": SCHEMA_VERSION,
        "project": "CryptoLab-DataHub",
        "state": "IDLE",
        "task_id": None,
        "task_title": None,
        "task_kind": None,
        "parent_task_id": None,
        "phase": None,
        "branch": None,
        "started_at": None,
        "updated_at": None,
        "completed_at": None,
        "tests": {
            "targeted": None,
            "full": None,
        },
        "human_gate": None,
        "last_gate_decision": None,
        "report": REPORT,
    }

    validate_runtime_state(data)
    return data


def read_status_document():
    """
    Read and parse canonical status.json without interpreting it.

    Both the normal load path and the migration path need the raw
    document, but they validate it against different contracts.
    """

    try:
        data = json.loads(STATUS.read_text())
    except json.JSONDecodeError as exc:
        raise SystemExit(
            f"Invalid status JSON: {STATUS}: {exc}"
        ) from exc

    if not isinstance(data, dict):
        raise SystemExit(
            f"Invalid status JSON: {STATUS}: expected an object."
        )

    return data


def load():
    """
    Canonical fail-closed load path.

    Schema 3.0 only. A schema-2.0 runtime is refused with explicit
    migration instructions rather than being silently upgraded,
    because an implicit upgrade would rewrite the operator's runtime
    state as a side effect of an unrelated command.
    """

    if not STATUS.exists():
        return idle_state()

    data = read_status_document()

    if data.get("schema_version") == LEGACY_SCHEMA_VERSION:
        raise SystemExit(MIGRATION_HINT)

    validate_runtime_state(data)
    return data


def load_legacy_state():
    """
    Dedicated raw legacy-read path used only by migrate-v3.

    This never calls load(): the normal load path refuses schema 2.0
    by design, so migration must read and validate the legacy
    document itself.
    """

    if not STATUS.exists():
        raise SystemExit(
            "No runtime status to migrate: "
            f"{STATUS} does not exist. A fresh runtime is already "
            f"schema {SCHEMA_VERSION}."
        )

    data = read_status_document()

    version = data.get("schema_version")

    if version == SCHEMA_VERSION:
        raise SystemExit(
            "Runtime status is already schema "
            f"{SCHEMA_VERSION}; nothing to migrate."
        )

    if version != LEGACY_SCHEMA_VERSION:
        raise SystemExit(
            "Cannot migrate unsupported schema_version: "
            f"{version!r}. Only schema {LEGACY_SCHEMA_VERSION} can "
            f"be migrated to schema {SCHEMA_VERSION}."
        )

    validate_legacy_runtime_state(data)

    return data


def format_test(name, result):
    title = "Targeted" if name == "targeted" else "Full suite"

    if not result:
        return [
            f"### {title}",
            "",
            "- **Result:** NOT RECORDED",
        ]

    command = result.get("command")
    command_text = f"`{command}`" if command else "NOT APPLICABLE"

    return [
        f"### {title}",
        "",
        f"- **Result:** {result.get('result', 'UNKNOWN')}",
        f"- **Command:** {command_text}",
        f"- **Summary:** {result.get('summary', '')}",
    ]


def recommended_action(data):
    state = data.get("state")

    if state == "BLOCKED_HUMAN_DECISION":
        gate = data.get("human_gate") or {}
        gate_id = gate.get("gate_id", "UNKNOWN")

        return (
            f"Human decision required for `{gate_id}`. "
            "Claude must not resolve this gate."
        )

    if state == "READY_FOR_HUMAN_REVIEW":
        return (
            "Review the completed work and decide whether "
            "a further Human Gate is required."
        )

    if state == "FAILED":
        return (
            "Review the failure record and decide whether to start "
            "a new task or revise the approved scope."
        )

    if state == "RUNNING":
        return (
            "Continue the approved autonomous workflow unless a "
            "Human Gate is reached."
        )

    if state == "IDLE":
        return "Start an approved task when ready."

    return "Review the current runtime state."


def render_report(data):
    REPORT_PATH.parent.mkdir(
        parents=True,
        exist_ok=True,
    )

    tests = data.get("tests") or {}
    gate = data.get("human_gate")
    last_decision = data.get("last_gate_decision")

    lines = [
        "# CryptoLab Autonomous Task Report",
        "",
        "## Runtime",
        "",
        f"- **Task ID:** {data.get('task_id') or 'NONE'}",
        f"- **Title:** {data.get('task_title') or 'NONE'}",
        f"- **Task kind:** {data.get('task_kind') or 'NONE'}",
        f"- **Parent Work Task:** "
        f"{data.get('parent_task_id') or 'NONE'}",
        f"- **State:** {data.get('state') or 'UNKNOWN'}",
        f"- **Phase:** {data.get('phase') or 'NONE'}",
        f"- **Branch:** {data.get('branch') or 'UNKNOWN'}",
        f"- **HEAD:** {head()}",
        f"- **Started:** {data.get('started_at') or 'NONE'}",
        f"- **Updated:** {data.get('updated_at') or 'NONE'}",
        f"- **Completed:** {data.get('completed_at') or 'NONE'}",
        f"- **Report generated:** {now()}",
        "",
        "## Working tree",
        "",
    ]

    tree = working_tree()

    if tree == "clean":
        lines.append("Working tree is clean.")
    else:
        lines.extend([
            "```text",
            tree,
            "```",
        ])

    lines.extend([
        "",
        "## Tests",
        "",
        *format_test(
            "targeted",
            tests.get("targeted"),
        ),
        "",
        *format_test(
            "full",
            tests.get("full"),
        ),
        "",
        "## Human Gate",
        "",
    ])

    if gate:
        lines.extend([
            "- **Status:** OPEN",
            f"- **Gate ID:** {gate.get('gate_id', 'UNKNOWN')}",
            f"- **Type:** {gate.get('type', 'UNKNOWN')}",
            f"- **Opened:** {gate.get('opened_at', 'UNKNOWN')}",
            f"- **Question:** {gate.get('question', '')}",
            f"- **Recommendation:** {gate.get('recommendation', '')}",
            "",
            "### Alternatives",
            "",
        ])

        alternatives = gate.get("alternatives") or []

        if alternatives:
            for item in alternatives:
                lines.append(f"- {item}")
        else:
            lines.append("- None recorded.")

        lines.extend([
            "",
            "### Risks",
            "",
        ])

        risks = gate.get("risks") or []

        if risks:
            for item in risks:
                lines.append(f"- {item}")
        else:
            lines.append("- None recorded.")

    else:
        lines.append("- **Status:** NONE OPEN")

    lines.extend([
        "",
        "## Last Human Gate Decision",
        "",
    ])

    if last_decision:
        lines.extend([
            f"- **Gate ID:** "
            f"{last_decision.get('gate_id', 'UNKNOWN')}",
            f"- **Decision:** "
            f"{last_decision.get('decision', 'UNKNOWN')}",
            f"- **Resolved:** "
            f"{last_decision.get('resolved_at', 'UNKNOWN')}",
            f"- **Record:** "
            f"{last_decision.get('record', '')}",
        ])
    else:
        lines.append(
            "- No recorded decision for the current task."
        )

    lines.extend([
        "",
        "## Runtime integrity",
        "",
        "- **Canonical status:** `.claude/runtime/status.json`",
        "- **Canonical audit:** `.claude/runtime/audit.jsonl`",
        f"- **Canonical report:** `{REPORT}`",
        f"- **Human Gate open:** {'YES' if gate else 'NO'}",
        f"- **statusctl lock:** `{LOCK_PATH}`",
        "- **Runtime validation:** ENFORCED",
        "",
        "## Recommended next action",
        "",
        recommended_action(data),
        "",
    ])

    tmp = REPORT_PATH.with_suffix(".md.tmp")
    tmp.write_text(
        "\n".join(lines)
    )
    tmp.replace(REPORT_PATH)


def save(data):
    data["updated_at"] = now()

    validate_runtime_state(data)

    STATUS.parent.mkdir(
        parents=True,
        exist_ok=True,
    )

    tmp = STATUS.with_suffix(".json.tmp")

    tmp.write_text(
        json.dumps(
            data,
            indent=2,
        )
        + "\n"
    )

    tmp.replace(STATUS)

    render_report(data)


def audit(event, **fields):
    AUDIT.parent.mkdir(
        parents=True,
        exist_ok=True,
    )

    record = {
        "timestamp": now(),
        "event": event,
        **fields,
    }

    with AUDIT.open("a") as handle:
        handle.write(
            json.dumps(record)
            + "\n"
        )


def next_gate_id():
    prefix = datetime.now(
        timezone.utc
    ).strftime("HG-%Y%m%d-")

    highest = 0

    if AUDIT.exists():
        for line in AUDIT.read_text().splitlines():
            try:
                record = json.loads(line)
            except json.JSONDecodeError:
                continue

            gate_id = record.get("gate_id")

            if not isinstance(
                gate_id,
                str,
            ):
                continue

            if not gate_id.startswith(prefix):
                continue

            try:
                number = int(
                    gate_id.rsplit(
                        "-",
                        1,
                    )[1]
                )
            except (
                IndexError,
                ValueError,
            ):
                continue

            highest = max(
                highest,
                number,
            )

    return f"{prefix}{highest + 1:03d}"


def test_is_ready(result):
    if not result:
        return False

    outcome = result.get("result")

    if outcome not in READY_TEST_RESULTS:
        return False

    if outcome == "PASS":
        return bool(
            str(
                result.get(
                    "command",
                    "",
                )
            ).strip()
            and str(
                result.get(
                    "summary",
                    "",
                )
            ).strip()
        )

    if outcome == "NOT_REQUIRED":
        return (
            result.get("command") is None
            and bool(
                str(
                    result.get(
                        "summary",
                        "",
                    )
                ).strip()
            )
        )

    return False


def migrate_state_to_v3(
    legacy,
    task_kind,
    parent_task_id,
):
    """
    Transform a validated schema-2.0 state into schema 3.0.

    The transformation is deterministic and preserves every legacy
    runtime field. Only the schema version and the new task-model
    fields are introduced.

    Callers must reject an IDLE legacy state before reaching here: an
    IDLE runtime carries no task to assign a kind to.
    """

    return {
        "schema_version": SCHEMA_VERSION,
        "project": legacy["project"],
        "state": legacy["state"],
        "task_id": legacy["task_id"],
        "task_title": legacy["task_title"],
        "task_kind": task_kind,
        "parent_task_id": (
            None
            if task_kind == TASK_KIND_WORK
            else parent_task_id
        ),
        "phase": legacy["phase"],
        "branch": legacy["branch"],
        "started_at": legacy["started_at"],
        "updated_at": legacy["updated_at"],
        "completed_at": legacy["completed_at"],
        "tests": legacy["tests"],
        "human_gate": legacy["human_gate"],
        "last_gate_decision": legacy["last_gate_decision"],
        "report": legacy["report"],
    }


def cmd_migrate_v3(args):
    """
    Explicit, operator-driven schema-2.0 to schema-3.0 migration.

    Order matters and is fail-closed throughout:

        raw legacy read (never load())
          ↓
        validate legacy v2 shape and invariants
          ↓
        deterministic transform
          ↓
        validate resulting v3 state
          ↓
        atomic replacement of canonical status.json
          ↓
        RUNTIME_SCHEMA_MIGRATED audit event

    A rejected migration leaves status.json byte-identical and
    appends no success event.
    """

    task_kind = args.task_kind
    parent_task_id = args.parent_task_id

    if task_kind == TASK_KIND_INTEGRATION:
        if parent_task_id is None or not parent_task_id.strip():
            raise SystemExit(
                "Migrating to an Integration Task requires the "
                "parent Work Task ID:\n"
                "    ./.claude/bin/statusctl migrate-v3 "
                "INTEGRATION PARENT_TASK_ID"
            )

        parent_task_id = parent_task_id.strip()

    elif parent_task_id is not None:
        raise SystemExit(
            "A Work Task has no parent task; "
            "parent_task_id is only valid for INTEGRATION."
        )

    legacy = load_legacy_state()

    # An IDLE runtime has no task, so there is nothing to assign a
    # task kind to. It is also unwritable by construction: save()
    # stamps updated_at, which IDLE requires to be null. Refusing here
    # keeps the reason visible instead of surfacing a validation error
    # that appears to blame the operator's file.
    if legacy["state"] == "IDLE":
        raise SystemExit(
            "Runtime status is IDLE, so there is no task to "
            f"migrate. A fresh runtime is already schema "
            f"{SCHEMA_VERSION}: remove the legacy status file, or "
            "start a task instead of migrating."
        )

    if (
        task_kind == TASK_KIND_INTEGRATION
        and same_task_identity(
            legacy["task_id"],
            parent_task_id,
        )
    ):
        raise SystemExit(
            "Cannot migrate to an Integration Task whose parent is "
            f"itself: parent_task_id {parent_task_id} equals the "
            "task's own task_id. Supply the ID of the Work Task "
            "being integrated."
        )

    if (
        task_kind == TASK_KIND_INTEGRATION
        and legacy["phase"] not in INTEGRATION_PHASES
    ):
        raise SystemExit(
            "Cannot migrate to an Integration Task: current phase "
            f"{legacy['phase']} is not legal for an Integration "
            "Task. Legal Integration Task phases are "
            f"{', '.join(sorted(INTEGRATION_PHASES))}."
        )

    migrated = migrate_state_to_v3(
        legacy,
        task_kind,
        parent_task_id,
    )

    # save() validates the candidate before atomically replacing
    # canonical status.json, so an invalid transform cannot reach disk.
    save(migrated)

    audit(
        "RUNTIME_SCHEMA_MIGRATED",
        task_id=migrated["task_id"],
        from_schema=LEGACY_SCHEMA_VERSION,
        to_schema=SCHEMA_VERSION,
        task_kind=migrated["task_kind"],
        parent_task_id=migrated["parent_task_id"],
        state=migrated["state"],
        phase=migrated["phase"],
    )

    print(
        f"Migrated runtime status to schema {SCHEMA_VERSION} "
        f"(task_kind={migrated['task_kind']})."
    )


def cmd_show(_):
    print(
        json.dumps(
            load(),
            indent=2,
        )
    )


def cmd_report(_):
    data = load()
    render_report(data)
    print(REPORT)


def cmd_start(args):
    data = load()

    if data["state"] not in {
        "IDLE",
        "READY_FOR_HUMAN_REVIEW",
        "FAILED",
    }:
        raise SystemExit(
            f"Cannot start task while state={data['state']}"
        )

    timestamp = now()

    data.update({
        "schema_version": SCHEMA_VERSION,
        "project": "CryptoLab-DataHub",
        "state": "RUNNING",
        "task_id": args.task_id,
        "task_title": args.title,
        "task_kind": TASK_KIND_WORK,
        "parent_task_id": None,
        "phase": "ANALYZE",
        "branch": branch(),
        "started_at": timestamp,
        "completed_at": None,
        "tests": {
            "targeted": None,
            "full": None,
        },
        "human_gate": None,
        "last_gate_decision": None,
        "report": REPORT,
    })

    save(data)

    audit(
        "TASK_STARTED",
        task_id=args.task_id,
        task_title=args.title,
        task_kind=TASK_KIND_WORK,
        parent_task_id=None,
        branch=data["branch"],
    )


def cmd_start_integration(args):
    """
    Start an Integration Task for a completed Work Task.

    Integration is only meaningful for work that has already reached
    human review, so the current task must be a Work Task in
    READY_FOR_HUMAN_REVIEW. Its task_id becomes the new Integration
    Task's parent, which is what ties an integration action back to
    the reviewed work it integrates.
    """

    data = load()

    if data["state"] != "READY_FOR_HUMAN_REVIEW":
        raise SystemExit(
            "Cannot start an Integration Task while "
            f"state={data['state']}. An Integration Task may only "
            "follow a Work Task in READY_FOR_HUMAN_REVIEW."
        )

    if data["task_kind"] != TASK_KIND_WORK:
        raise SystemExit(
            "Cannot start an Integration Task from "
            f"task_kind={data['task_kind']}. The parent must be a "
            "WORK task."
        )

    parent_task_id = data["task_id"]

    require_non_empty_string(
        parent_task_id,
        "parent_task_id",
    )

    # Semantics A keeps the reviewed work and the act of integrating
    # it as two separate, individually auditable identities. Reusing
    # the parent's ID would collapse them into one.
    if same_task_identity(
        args.task_id,
        parent_task_id,
    ):
        raise SystemExit(
            "Cannot start an Integration Task with the same task_id "
            f"as its parent Work Task ({parent_task_id}). Give the "
            "Integration Task its own identity."
        )

    timestamp = now()

    data.update({
        "schema_version": SCHEMA_VERSION,
        "project": "CryptoLab-DataHub",
        "state": "RUNNING",
        "task_id": args.task_id,
        "task_title": args.title,
        "task_kind": TASK_KIND_INTEGRATION,
        "parent_task_id": parent_task_id,
        "phase": "ANALYZE",
        "branch": branch(),
        "started_at": timestamp,
        "completed_at": None,
        "tests": {
            "targeted": None,
            "full": None,
        },
        "human_gate": None,
        "last_gate_decision": None,
        "report": REPORT,
    })

    save(data)

    audit(
        "INTEGRATION_TASK_STARTED",
        task_id=args.task_id,
        task_title=args.title,
        task_kind=TASK_KIND_INTEGRATION,
        parent_task_id=parent_task_id,
        branch=data["branch"],
    )


def cmd_phase(args):
    data = load()

    if data["state"] != "RUNNING":
        raise SystemExit(
            f"Cannot change phase while state={data['state']}"
        )

    task_kind = data["task_kind"]
    allowed = PHASES_BY_TASK_KIND.get(task_kind, set())

    if args.phase not in allowed:
        raise SystemExit(
            f"Phase {args.phase} is not legal for a {task_kind} "
            "task. Legal phases are "
            f"{', '.join(sorted(allowed))}."
        )

    previous = data["phase"]

    data["phase"] = args.phase

    save(data)

    audit(
        "PHASE_CHANGED",
        task_id=data["task_id"],
        previous_phase=previous,
        phase=args.phase,
    )


def cmd_test(args):
    data = load()

    if data["state"] != "RUNNING":
        raise SystemExit(
            f"Cannot record test while state={data['state']}"
        )

    command = args.command.strip()
    summary = args.summary.strip()

    if not command:
        raise SystemExit(
            f"{args.result} requires a non-empty test command."
        )

    if not summary:
        raise SystemExit(
            f"{args.result} requires a non-empty summary."
        )

    test_record = {
        "command": command,
        "result": args.result,
        "summary": summary,
    }

    data["tests"][args.kind] = test_record

    save(data)

    audit(
        "TEST_RECORDED",
        task_id=data["task_id"],
        kind=args.kind,
        result=test_record["result"],
        command=test_record["command"],
        summary=test_record["summary"],
    )


def cmd_test_not_required(args):
    data = load()

    if data["state"] != "RUNNING":
        raise SystemExit(
            "Cannot record test exemption while "
            f"state={data['state']}"
        )

    reason = args.reason.strip()

    if not reason:
        raise SystemExit(
            "NOT_REQUIRED requires a non-empty reason."
        )

    test_record = {
        "command": None,
        "result": "NOT_REQUIRED",
        "summary": reason,
    }

    data["tests"][args.kind] = test_record

    save(data)

    audit(
        "TEST_NOT_REQUIRED_RECORDED",
        task_id=data["task_id"],
        kind=args.kind,
        result="NOT_REQUIRED",
        command=None,
        summary=reason,
    )


def cmd_gate_open(args):
    data = load()

    if data["state"] != "RUNNING":
        raise SystemExit(
            f"Cannot open gate while state={data['state']}"
        )

    if (
        args.type in INTEGRATION_ONLY_GATE_TYPES
        and data["task_kind"] != TASK_KIND_INTEGRATION
    ):
        raise SystemExit(
            f"Gate type {args.type} is Integration-Task-only, but "
            f"the current task_kind is {data['task_kind']}. Start "
            "an Integration Task with start-integration before "
            "requesting an integration decision."
        )

    opened_at = now()
    gate_id = next_gate_id()

    gate = {
        "gate_id": gate_id,
        "type": args.type,
        "question": args.question,
        "recommendation": args.recommendation,
        "alternatives": args.alternative or [],
        "risks": args.risk or [],
        "opened_at": opened_at,
    }

    data["state"] = "BLOCKED_HUMAN_DECISION"
    data["human_gate"] = gate

    save(data)

    audit(
        "HUMAN_GATE_OPENED",
        task_id=data["task_id"],
        gate_id=gate_id,
        gate_type=gate["type"],
        question=gate["question"],
        recommendation=gate["recommendation"],
        gate=gate,
    )


def require_open_gate(
    data,
    expected_gate_id,
):
    if data["state"] != "BLOCKED_HUMAN_DECISION":
        raise SystemExit(
            "Human gate decision requires "
            "state=BLOCKED_HUMAN_DECISION"
        )

    gate = data.get("human_gate")

    if not gate:
        raise SystemExit(
            "Human gate decision requires an active human_gate"
        )

    active_gate_id = gate.get("gate_id")

    if active_gate_id != expected_gate_id:
        raise SystemExit(
            "Human Gate ID mismatch: "
            f"requested={expected_gate_id}, "
            f"active={active_gate_id}. "
            "Refusing stale or incorrect gate resolution."
        )

    return gate


def resolve_gate(
    data,
    gate,
    decision,
    record,
    event,
):
    resolved_at = now()

    data["state"] = "RUNNING"
    data["human_gate"] = None
    data["last_gate_decision"] = {
        "gate_id": gate["gate_id"],
        "decision": decision,
        "resolved_at": resolved_at,
        "record": record,
    }

    save(data)

    audit(
        event,
        task_id=data["task_id"],
        gate_id=gate["gate_id"],
        gate_type=gate["type"],
        decision=decision,
        decision_record=record,
        opened_at=gate["opened_at"],
        resolved_at=resolved_at,
        gate=gate,
    )


def cmd_gate_approve(args):
    data = load()

    gate = require_open_gate(
        data,
        args.gate_id,
    )

    resolve_gate(
        data=data,
        gate=gate,
        decision="APPROVED",
        record=args.decision,
        event="HUMAN_GATE_APPROVED",
    )


def cmd_gate_alternative(args):
    data = load()

    gate = require_open_gate(
        data,
        args.gate_id,
    )

    resolve_gate(
        data=data,
        gate=gate,
        decision="ALTERNATIVE",
        record=args.decision,
        event="HUMAN_GATE_ALTERNATIVE_CHOSEN",
    )


def cmd_gate_reject(args):
    data = load()

    gate = require_open_gate(
        data,
        args.gate_id,
    )

    resolve_gate(
        data=data,
        gate=gate,
        decision="REJECTED",
        record=args.reason,
        event="HUMAN_GATE_REJECTED",
    )


def cmd_ready(_):
    data = load()

    if data["state"] != "RUNNING":
        raise SystemExit(
            f"Cannot mark ready while state={data['state']}"
        )

    if data.get("human_gate") is not None:
        raise SystemExit(
            "Cannot mark ready while a Human Gate is open."
        )

    # The phase must already reflect completed verification work.
    # Setting it here would let `ready` manufacture the very evidence
    # it is supposed to check.
    if data["phase"] != "FINAL_VERIFY":
        raise SystemExit(
            "Cannot mark ready while phase="
            f"{data['phase']}. Record FINAL_VERIFY only once final "
            "verification has actually been performed."
        )

    targeted = data["tests"].get("targeted")
    full = data["tests"].get("full")

    if not test_is_ready(targeted):
        raise SystemExit(
            "Targeted test requirement is not satisfied. "
            "Expected PASS or justified NOT_REQUIRED."
        )

    if not test_is_ready(full):
        raise SystemExit(
            "Full test suite requirement is not satisfied. "
            "Expected PASS or justified NOT_REQUIRED."
        )

    data["state"] = "READY_FOR_HUMAN_REVIEW"
    data["human_gate"] = None
    data["completed_at"] = now()

    save(data)

    audit(
        "TASK_READY_FOR_HUMAN_REVIEW",
        task_id=data["task_id"],
        task_kind=data["task_kind"],
        parent_task_id=data["parent_task_id"],
        targeted_result=targeted["result"],
        full_result=full["result"],
    )


def cmd_fail(args):
    data = load()

    if data["state"] == "BLOCKED_HUMAN_DECISION":
        raise SystemExit(
            "Cannot fail task while "
            "state=BLOCKED_HUMAN_DECISION. "
            "The active Human Gate must be resolved by a human."
        )

    if data["state"] != "RUNNING":
        raise SystemExit(
            f"Cannot fail task while state={data['state']}"
        )

    data["state"] = "FAILED"
    data["completed_at"] = now()
    data["human_gate"] = None

    save(data)

    audit(
        "TASK_FAILED",
        task_id=data["task_id"],
        summary=args.summary,
        previous_gate=None,
    )


def main():
    parser = argparse.ArgumentParser(
        description="CryptoLab Claude runtime state controller"
    )

    sub = parser.add_subparsers(
        dest="cmd",
        required=True,
    )

    p = sub.add_parser("show")
    p.set_defaults(func=cmd_show)

    p = sub.add_parser("report")
    p.set_defaults(func=cmd_report)

    p = sub.add_parser("start")
    p.add_argument("task_id")
    p.add_argument("title")
    p.set_defaults(func=cmd_start)

    p = sub.add_parser("start-integration")
    p.add_argument("task_id")
    p.add_argument("title")
    p.set_defaults(func=cmd_start_integration)

    p = sub.add_parser("migrate-v3")
    p.add_argument(
        "task_kind",
        choices=sorted(VALID_TASK_KINDS),
    )
    p.add_argument(
        "parent_task_id",
        nargs="?",
        default=None,
    )
    p.set_defaults(func=cmd_migrate_v3)

    p = sub.add_parser("phase")
    p.add_argument(
        "phase",
        choices=sorted(VALID_PHASES),
    )
    p.set_defaults(func=cmd_phase)

    p = sub.add_parser("test")
    p.add_argument(
        "kind",
        choices=["targeted", "full"],
    )
    p.add_argument(
        "result",
        choices=["PASS", "FAIL"],
    )
    p.add_argument("command")
    p.add_argument("summary")
    p.set_defaults(func=cmd_test)

    p = sub.add_parser("test-not-required")
    p.add_argument(
        "kind",
        choices=["targeted", "full"],
    )
    p.add_argument("reason")
    p.set_defaults(func=cmd_test_not_required)

    gate = sub.add_parser("gate")
    gate_sub = gate.add_subparsers(
        dest="gate_cmd",
        required=True,
    )

    p = gate_sub.add_parser("open")
    p.add_argument(
        "type",
        choices=sorted(VALID_GATE_TYPES),
    )
    p.add_argument("question")
    p.add_argument("recommendation")
    p.add_argument(
        "--alternative",
        action="append",
    )
    p.add_argument(
        "--risk",
        action="append",
    )
    p.set_defaults(func=cmd_gate_open)

    p = gate_sub.add_parser("approve")
    p.add_argument("gate_id")
    p.add_argument("decision")
    p.set_defaults(func=cmd_gate_approve)

    p = gate_sub.add_parser("alternative")
    p.add_argument("gate_id")
    p.add_argument("decision")
    p.set_defaults(func=cmd_gate_alternative)

    p = gate_sub.add_parser("reject")
    p.add_argument("gate_id")
    p.add_argument("reason")
    p.set_defaults(func=cmd_gate_reject)

    p = sub.add_parser("ready")
    p.set_defaults(func=cmd_ready)

    p = sub.add_parser("fail")
    p.add_argument(
        "summary",
        nargs="?",
        default="",
    )
    p.set_defaults(func=cmd_fail)

    args = parser.parse_args()

    with control_lock():
        args.func(args)


if __name__ == "__main__":
    main()
