{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cryptolab-claude-status-v3",
  "title": "CryptoLab Claude Runtime Status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "state",
    "task_id",
    "task_title",
    "task_kind",
    "parent_task_id",
    "phase",
    "branch",
    "started_at",
    "updated_at",
    "completed_at",
    "tests",
    "human_gate",
    "last_gate_decision",
    "report"
  ],
  "properties": {
    "schema_version": {
      "const": "3.0"
    },
    "project": {
      "const": "CryptoLab-DataHub"
    },
    "state": {
      "enum": [
        "IDLE",
        "RUNNING",
        "BLOCKED_HUMAN_DECISION",
        "READY_FOR_HUMAN_REVIEW",
        "FAILED"
      ]
    },
    "task_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "task_title": {
      "type": [
        "string",
        "null"
      ]
    },
    "task_kind": {
      "enum": [
        null,
        "WORK",
        "INTEGRATION"
      ]
    },
    "parent_task_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "phase": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "ANALYZE",
        "IMPLEMENT",
        "TARGETED_TEST",
        "FULL_TEST",
        "ADVERSARIAL_REVIEW",
        "CORRECT_FINDINGS",
        "RETEST",
        "EXTERNAL_REVIEW",
        "CORRECT_EXTERNAL_FINDINGS",
        "FINAL_VERIFY"
      ]
    },
    "branch": {
      "type": [
        "string",
        "null"
      ]
    },
    "started_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targeted",
        "full"
      ],
      "properties": {
        "targeted": {
          "$ref": "#/$defs/testResult"
        },
        "full": {
          "$ref": "#/$defs/testResult"
        }
      }
    },
    "human_gate": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/humanGate"
        }
      ]
    },
    "last_gate_decision": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/gateDecision"
        }
      ]
    },
    "report": {
      "const": ".claude/runtime/latest_report.md"
    }
  },
  "allOf": [
    {
      "$comment": "IDLE carries no task, so it carries no task model.",
      "if": {
        "properties": {
          "state": {
            "const": "IDLE"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "task_kind": {
            "const": null
          },
          "parent_task_id": {
            "const": null
          }
        }
      }
    },
    {
      "$comment": "A task-bearing state requires a task kind.",
      "if": {
        "properties": {
          "state": {
            "enum": [
              "RUNNING",
              "BLOCKED_HUMAN_DECISION",
              "READY_FOR_HUMAN_REVIEW",
              "FAILED"
            ]
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "task_kind": {
            "enum": [
              "WORK",
              "INTEGRATION"
            ]
          }
        }
      }
    },
    {
      "$comment": "A Work Task has no parent and uses the full Work lifecycle.",
      "if": {
        "properties": {
          "task_kind": {
            "const": "WORK"
          }
        },
        "required": [
          "task_kind"
        ]
      },
      "then": {
        "properties": {
          "parent_task_id": {
            "const": null
          },
          "phase": {
            "enum": [
              "ANALYZE",
              "IMPLEMENT",
              "TARGETED_TEST",
              "FULL_TEST",
              "ADVERSARIAL_REVIEW",
              "CORRECT_FINDINGS",
              "RETEST",
              "EXTERNAL_REVIEW",
              "CORRECT_EXTERNAL_FINDINGS",
              "FINAL_VERIFY"
            ]
          }
        }
      }
    },
    {
      "$comment": "An Integration Task requires a parent Work Task and uses the narrow Integration lifecycle. The further invariant task_id != parent_task_id cannot be expressed here: JSON Schema draft 2020-12 has no way to compare one property's value against a sibling property's value, and no non-standard extension is used to fake it. That cross-field rule is enforced by the internal validator in .claude/bin/statusctl (validate_task_model).",
      "if": {
        "properties": {
          "task_kind": {
            "const": "INTEGRATION"
          }
        },
        "required": [
          "task_kind"
        ]
      },
      "then": {
        "properties": {
          "parent_task_id": {
            "type": "string",
            "minLength": 1
          },
          "phase": {
            "enum": [
              "ANALYZE",
              "FINAL_VERIFY"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "testResult": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "command",
            "result",
            "summary"
          ],
          "properties": {
            "command": {
              "type": "string",
              "minLength": 1
            },
            "result": {
              "enum": [
                "PASS",
                "FAIL"
              ]
            },
            "summary": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "command",
            "result",
            "summary"
          ],
          "properties": {
            "command": {
              "type": "null"
            },
            "result": {
              "const": "NOT_REQUIRED"
            },
            "summary": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "humanGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_id",
        "type",
        "question",
        "recommendation",
        "alternatives",
        "risks",
        "opened_at"
      ],
      "properties": {
        "gate_id": {
          "type": "string",
          "pattern": "^HG-[0-9]{8}-[0-9]{3,}$"
        },
        "type": {
          "enum": [
            "GIT_INTEGRATION",
            "DEPENDENCY_CHANGE",
            "DATA_MUTATION",
            "SECURITY_AUTH",
            "OS_CHANGE",
            "SEMANTIC_DECISION",
            "ARCHITECTURE_DECISION",
            "SCOPE_EXPANSION",
            "UNRESOLVED_DISCUSS",
            "OTHER"
          ]
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "recommendation": {
          "type": "string",
          "minLength": 1
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "opened_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "gateDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_id",
        "decision",
        "resolved_at",
        "record"
      ],
      "properties": {
        "gate_id": {
          "type": "string",
          "pattern": "^HG-[0-9]{8}-[0-9]{3,}$"
        },
        "decision": {
          "enum": [
            "APPROVED",
            "ALTERNATIVE",
            "REJECTED"
          ]
        },
        "resolved_at": {
          "type": "string",
          "format": "date-time"
        },
        "record": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
